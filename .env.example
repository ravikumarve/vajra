# Vajra — example environment. Copy to `.env` (gitignored), never commit secrets.
# Agent secrets are minted per agent (`vajra mint ...`), not invented here.
#   cp .env.example .env

# Agent identity for adapters (see docs/INTEGRATIONS.md)
VAJRA_ENDPOINT=http://localhost:9735
VAJRA_AGENT_ID=my-agent-001
VAJRA_AGENT_SECRET=<minted-per-agent-via-vajra-mint>

# Credential + policy defaults
VAJRA_DEFAULT_TTL=5s
VAJRA_POLICY_TAGS=read-only
